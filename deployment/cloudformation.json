{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CareFlow hospital demonstration: Python Lambda, HTTP API Gateway, DynamoDB. No CloudFront.",
  "Parameters": {
    "CodeBucket": {
      "Type": "String"
    },
    "CodeKey": {
      "Type": "String"
    },
    "AdminSetupKey": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 32
    },
    "ExistingLambdaRoleArn": {
      "Type": "String",
      "Default": "",
      "Description": "Optional existing Lambda execution role, e.g. AWS Academy LabRole; must allow DynamoDB transactions and CloudWatch logs."
    }
  },
  "Conditions": {
    "CreateRole": {
      "Fn::Equals": [
        {
          "Ref": "ExistingLambdaRoleArn"
        },
        ""
      ]
    }
  },
  "Resources": {
    "HospitalTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expires",
          "Enabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "CreateRole",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "CareFlowAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:Scan",
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "HospitalTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-app:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "FunctionLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-app"
        },
        "RetentionInDays": 7
      }
    },
    "HospitalFunction": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "FunctionLogs",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-app"
        },
        "Runtime": "python3.12",
        "Handler": "lambda_function.lambda_handler",
        "Architectures": [
          "arm64"
        ],
        "Role": {
          "Fn::If": [
            "CreateRole",
            {
              "Fn::GetAtt": [
                "ExecutionRole",
                "Arn"
              ]
            },
            {
              "Ref": "ExistingLambdaRoleArn"
            }
          ]
        },
        "MemorySize": 256,
        "Timeout": 20,
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "HospitalTable"
            },
            "ADMIN_SETUP_KEY": {
              "Ref": "AdminSetupKey"
            }
          }
        }
      }
    },
    "HospitalApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "ProtocolType": "HTTP"
      }
    },
    "LambdaIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HospitalApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "HospitalFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 25000
      }
    },
    "DefaultRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HospitalApi"
        },
        "RouteKey": "$default",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "LambdaIntegration"
              }
            ]
          ]
        }
      }
    },
    "DefaultStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HospitalApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 10,
          "ThrottlingRateLimit": 5
        }
      }
    },
    "InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "HospitalFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HospitalApi}/*"
        }
      }
    }
  },
  "Outputs": {
    "AppUrl": {
      "Value": {
        "Fn::Sub": "https://${HospitalApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}/"
      }
    },
    "TableName": {
      "Value": {
        "Ref": "HospitalTable"
      }
    },
    "FunctionName": {
      "Value": {
        "Ref": "HospitalFunction"
      }
    }
  }
}
